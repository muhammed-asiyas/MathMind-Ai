MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000

# Gmail SMTP: use a Google App Password, never your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM=MathMind AI <your_gmail_address@gmail.com>

# Optional AI tutor provider. Without this, the server uses its built-in maths helper.
OPENAI_API_KEY=your_openai_api_key
AI_MODEL=gpt-4o-mini
AI_API_URL=https://api.openai.com/v1/chat/completions
